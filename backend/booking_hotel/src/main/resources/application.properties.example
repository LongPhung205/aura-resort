# ===================================================================
# APPLICATION TEMPLATE EXAMPLE (File mẫu hướng dẫn cấu hình)
# Cách dùng: Copy file này thành 'application.properties' khi clone dự án về
# ===================================================================
spring.application.name=booking_hotel
server.port=8080
server.servlet.context-path=/api/v1

# Profile kích hoạt mặc định (dev / prod / test)
spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}

# Import cấu hình cá nhân (nếu có)
spring.config.import=optional:classpath:application-local.properties,optional:file:./application-local.properties

# Tối ưu hiệu năng nén GZIP & Tomcat
server.compression.enabled=true
server.compression.mime-types=application/json,text/html,text/xml,text/plain
server.compression.min-response-size=1024
server.tomcat.threads.max=200
server.tomcat.threads.min-spare=20
server.shutdown=graceful

# JPA Base Settings
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.batch_size=50

# Multipart Upload Limits
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

app.otp.expiration=5
